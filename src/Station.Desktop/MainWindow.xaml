<Window x:Class="Station.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Station.Desktop.ViewModels"
        Title="AI-KTV Station" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#171327" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,28"><TextBlock Text="AI-KTV" Foreground="White" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="Station 主控" Foreground="#B9B3C9" Margin="0,4,0,0" /></StackPanel>
                <ItemsControl ItemsSource="{Binding NavigationItems}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Page}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Foreground="White" Background="#2A2340" BorderThickness="0" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="32,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel><StackPanel><TextBlock Text="{Binding CurrentTitle}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" /><TextBlock Text="{Binding CurrentDescription}" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><Border DockPanel.Dock="Right" Background="#E9F8EF" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="● 本机服务" Foreground="#137A46" /></Border></DockPanel>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="30">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:DesktopPage.Dashboard}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel><DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="系统健康" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding HealthStatus}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" /></StackPanel><Button DockPanel.Dock="Right" Content="刷新状态" Command="{Binding RefreshHealthCommand}" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" /></DockPanel><ItemsControl ItemsSource="{Binding HealthComponents}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F7F5FF" CornerRadius="12" Padding="18" Margin="6"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" Margin="0,9,0,3" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="30" DataContext="{Binding PlaybackConsole}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DesktopPage.NowPlaying}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel><StackPanel><TextBlock Text="播放控制台" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" /></StackPanel><Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" /></DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,28,0,0"><TextBlock Text="{Binding PositionText}" HorizontalAlignment="Center" FontSize="18" /><Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" Margin="0,10" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="播放" Command="{Binding PlayCommand}" Margin="4" /><Button Content="暂停" Command="{Binding PauseCommand}" Margin="4" /><Button Content="跳转" Command="{Binding SeekCommand}" Margin="4" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" /></StackPanel></StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,25,0,0"><TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,12,0" /><Slider Width="280" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" /><TextBlock Text="{Binding Volume, StringFormat={}{0:F0}%}" Width="58" VerticalAlignment="Center" Margin="12,0" /><Button Content="应用音量" Command="{Binding ApplyVolumeCommand}" /></StackPanel>
                    <Grid Grid.Row="3" Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions><GroupBox Header="原唱 / 伴奏音轨" Padding="12"><ItemsControl ItemsSource="{Binding AudioTracks}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.SelectAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding StreamId}" HorizontalContentAlignment="Left" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox><GroupBox Grid.Column="2" Header="字幕" Padding="12"><StackPanel><Button Content="关闭字幕" Command="{Binding SelectSubtitleCommand}" CommandParameter="{x:Null}" HorizontalContentAlignment="Left" Margin="0,4" /><ItemsControl ItemsSource="{Binding SubtitleTracks}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.SelectSubtitleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding StreamId}" HorizontalContentAlignment="Left" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></GroupBox></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

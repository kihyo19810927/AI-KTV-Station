<Window x:Class="Station.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Station.Desktop.ViewModels"
        Title="AI-KTV Station" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#171327" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="4,8,4,28"><TextBlock Text="AI-KTV" Foreground="White" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="Station 主控" Foreground="#B9B3C9" Margin="0,4,0,0" /></StackPanel>
                <ItemsControl ItemsSource="{Binding NavigationItems}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Page}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Foreground="White" Background="#2A2340" BorderThickness="0" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="32,26">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel><StackPanel><TextBlock Text="{Binding CurrentTitle}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" /><TextBlock Text="{Binding CurrentDescription}" Margin="0,5,0,0" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><Border DockPanel.Dock="Right" Background="#E9F8EF" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="● 本机服务" Foreground="#137A46" /></Border></DockPanel>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="30">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static vm:DesktopPage.Dashboard}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel><DockPanel Margin="0,0,0,22"><StackPanel><TextBlock Text="系统健康" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding HealthStatus}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" /></StackPanel><Button DockPanel.Dock="Right" Content="刷新状态" Command="{Binding RefreshHealthCommand}" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" /></DockPanel><ItemsControl ItemsSource="{Binding HealthComponents}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="#F7F5FF" CornerRadius="12" Padding="18" Margin="6"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" /><TextBlock Text="{Binding Level}" Foreground="{StaticResource AccentBrush}" Margin="0,9,0,3" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="30" DataContext="{Binding PlaybackConsole}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DesktopPage.NowPlaying}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel><StackPanel><TextBlock Text="播放控制台" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" /></StackPanel><Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}" /></DockPanel>
                    <StackPanel Grid.Row="1" Margin="0,28,0,0"><TextBlock Text="{Binding PositionText}" HorizontalAlignment="Center" FontSize="18" /><Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" Margin="0,10" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="播放" Command="{Binding PlayCommand}" Margin="4" /><Button Content="暂停" Command="{Binding PauseCommand}" Margin="4" /><Button Content="跳转" Command="{Binding SeekCommand}" Margin="4" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" /></StackPanel></StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,25,0,0"><TextBlock Text="音量" VerticalAlignment="Center" Margin="0,0,12,0" /><Slider Width="280" Minimum="0" Maximum="100" Value="{Binding Volume}" VerticalAlignment="Center" /><TextBlock Text="{Binding Volume, StringFormat={}{0:F0}%}" Width="58" VerticalAlignment="Center" Margin="12,0" /><Button Content="应用音量" Command="{Binding ApplyVolumeCommand}" /></StackPanel>
                    <Grid Grid.Row="3" Margin="0,28,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions><GroupBox Header="原唱 / 伴奏音轨" Padding="12"><ItemsControl ItemsSource="{Binding AudioTracks}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.SelectAudioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding StreamId}" HorizontalContentAlignment="Left" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></GroupBox><GroupBox Grid.Column="2" Header="字幕" Padding="12"><StackPanel><Button Content="关闭字幕" Command="{Binding SelectSubtitleCommand}" CommandParameter="{x:Null}" HorizontalContentAlignment="Left" Margin="0,4" /><ItemsControl ItemsSource="{Binding SubtitleTracks}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding DataContext.SelectSubtitleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding StreamId}" HorizontalContentAlignment="Left" Margin="0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></GroupBox></Grid>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="30" DataContext="{Binding QueueManagement}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DesktopPage.Queue}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,18"><StackPanel><TextBlock Text="点歌队列" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4,0,0" /></StackPanel><Button DockPanel.Dock="Right" Content="刷新队列" Command="{Binding RefreshCommand}" /></DockPanel>
                    <ListView ItemsSource="{Binding Items}" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Border Background="#F7F5FF" CornerRadius="10" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Position}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" /><TextBlock Text="{Binding RequestedByNickname, StringFormat=点歌：{0}}" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="↑" ToolTip="上移" Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Margin="3" /><Button Content="↓" ToolTip="下移" Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Margin="3" /><Button Content="插播" Command="{Binding DataContext.MoveTopCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Margin="3" /><Button Content="删除" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Margin="3" /></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="24" DataContext="{Binding CatalogManagement}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DesktopPage.Catalog}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><TextBox Width="300" MinHeight="40" Padding="10,7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" /><Button Content="搜索" Command="{Binding SearchCommand}" Margin="8,0,0,0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" /></StackPanel><TextBlock DockPanel.Dock="Right" Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" /></DockPanel>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                        <ListView ItemsSource="{Binding Songs}" BorderBrush="#E5E7EB"><ListView.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.SelectSongCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"><StackPanel Margin="4"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Artists}" Foreground="{StaticResource SecondaryTextBrush}" /></StackPanel></Button></DataTemplate></ListView.ItemTemplate></ListView>
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="人工元数据修正" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="标题" Margin="0,12,0,4" /><TextBox Text="{Binding EditTitle}" Padding="8" /><TextBlock Text="语言" Margin="0,10,0,4" /><TextBox Text="{Binding EditLanguage}" Padding="8" /><TextBlock Text="分类" Margin="0,10,0,4" /><TextBox Text="{Binding EditCategory}" Padding="8" /><TextBlock Text="年份" Margin="0,10,0,4" /><TextBox Text="{Binding EditYear}" Padding="8" /><TextBlock Text="画质" Margin="0,10,0,4" /><TextBox Text="{Binding EditQuality}" Padding="8" /><Button Content="保存修正" Command="{Binding SaveMetadataCommand}" Margin="0,14,0,0" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" /></StackPanel></ScrollViewer>
                    </Grid>
                    <Border Grid.Row="2" Background="#F7F5FF" CornerRadius="10" Padding="12" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox Width="210" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" /><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0"><TextBox Width="120" Text="{Binding SourceName}" ToolTip="媒体源名称，例如 2016年10月" Padding="8" /><TextBox Width="330" Text="{Binding SourcePath}" ToolTip="年度或月份目录" Padding="8" Margin="8,0" /><Button Content="添加目录" Command="{Binding AddSourceCommand}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="扫描所选目录" Command="{Binding StartScanCommand}" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="3" /><Button Content="取消" Command="{Binding CancelScanCommand}" Margin="3" /></StackPanel></Grid></Border>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="28" DataContext="{Binding RoomManagement}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DesktopPage.Room}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="扫码点歌" FontSize="22" FontWeight="SemiBold" /><Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16"><Image Width="240" Height="240" Source="{Binding QrCodePng, Converter={StaticResource ByteArrayImageConverter}}" /></Border><TextBlock Text="{Binding JoinCode}" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" /><TextBlock Text="{Binding JoinUrl}" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,8" /><TextBlock Text="二维码只包含局域网地址和房间码" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" /></StackPanel>
                    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="房间管理" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,4" /></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="开启房间" Command="{Binding CreateCommand}" Margin="3" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" /><Button Content="刷新" Command="{Binding RefreshCommand}" Margin="3" /><Button Content="关闭房间" Command="{Binding CloseCommand}" Margin="3" /></StackPanel></DockPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,20"><TextBlock Text="每位访客最多排队" VerticalAlignment="Center" /><TextBox Width="60" Text="{Binding QueueLimit}" Padding="8" Margin="10,0" /><TextBlock Text="首" VerticalAlignment="Center" /><Button Content="保存规则" Command="{Binding SaveRulesCommand}" Margin="14,0" /></StackPanel><GroupBox Grid.Row="2" Header="访客" Padding="10"><ListView ItemsSource="{Binding Guests}" BorderThickness="0"><ListView.ItemTemplate><DataTemplate><Grid Margin="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding Role}" Foreground="{StaticResource SecondaryTextBrush}" /><Button Grid.Column="2" Content="移除" Command="{Binding DataContext.RevokeGuestCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" /></Grid></DataTemplate></ListView.ItemTemplate></ListView></GroupBox></Grid>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="18" Padding="30" DataContext="{Binding Settings}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.CurrentPage, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static vm:DesktopPage.Settings}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="760"><TextBlock Text="设置与诊断" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,5,0,20" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="监听地址" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding BindAddress}" Padding="9" Margin="0,4" /><TextBlock Grid.Row="1" Text="端口" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Port}" Padding="9" Margin="0,4" /><TextBlock Grid.Row="2" Text="数据目录" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DataDirectory}" Padding="9" Margin="0,4" /><TextBlock Grid.Row="3" Text="mpv 可执行文件" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PlayerExecutable}" Padding="9" Margin="0,4" /><TextBlock Grid.Row="4" Text="命令超时（秒）" VerticalAlignment="Center" /><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CommandTimeoutSeconds}" Padding="9" Margin="0,4" /></Grid>
                    <StackPanel Orientation="Horizontal" Margin="180,18,0,0"><Button Content="保存设置" Command="{Binding SaveCommand}" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="0,0,8,0" /><Button Content="导出脱敏诊断报告" Command="{Binding ExportDiagnosticsCommand}" /></StackPanel>
                    <Border Background="#FFF8E6" CornerRadius="10" Padding="16" Margin="0,28,0,0"><StackPanel><TextBlock Text="恢复原则" FontWeight="SemiBold" /><TextBlock Text="数据库异常：先备份现有文件，禁止删库重建。" Margin="0,8,0,0" /><TextBlock Text="挂载异常：恢复 CloudDrive 后只重扫所选来源，离线索引会保留。" /><TextBlock Text="播放器异常：确认 mpv 路径或 WinGet 安装，再重启主控。" /></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

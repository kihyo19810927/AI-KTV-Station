<Application x:Class="Station.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="AccentColor">#7C3AED</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F3F4F8" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#171923" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#667085" />
            <Style TargetType="Button"><Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="14,8" /><Setter Property="Cursor" Value="Hand" /></Style>
            <Style TargetType="ListView"><Setter Property="AllowDrop" Value="True" /><EventSetter Event="PreviewMouseMove" Handler="QueueList_PreviewMouseMove" /><EventSetter Event="Drop" Handler="QueueList_Drop" /></Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Station.Application\Station.Application.csproj" />
    <ProjectReference Include="..\Station.Infrastructure\Station.Infrastructure.csproj" />
    <ProjectReference Include="..\Station.Server\Station.Server.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Station.Server\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
